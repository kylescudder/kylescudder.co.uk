    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/react": "7.1.1",
    "@tabler/icons-react": "3.49.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "moment-timezone": "0.6.5",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1"
  },
  "lint-staged": {
    "*": "prettier --check --ignore-unknown"
  },
