{
  "name": "kylescudder-site",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "My portfolio site written using astro.",
  "author": {
    "name": "kylescudder"
  },
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "scripts": {
