---
import HeadSEO from '../components/HeadSEO.astro'
import { EXPERIENCE, LINKS, PROJECTS } from '../lib/constants'

const stack = ['C#', '.NET', 'TypeScript', 'React', 'Next.js', 'Rust']
const featuredProjects = PROJECTS.slice(0, 5)
const recentExperience = EXPERIENCE.slice(0, 3)

const contacts = [
  { label: 'GitHub', href: LINKS.github },
  { label: 'LinkedIn', href: LINKS.linkedin },
  { label: 'Email', href: LINKS.mail },
]
---

<html lang="en">
  <head>
    <HeadSEO
      title="Kyle Scudder - Portfolio Redesign Concepts"
      description="Five competing portfolio redesign directions for Kyle Scudder."
      ogImage={new URL('me.png', Astro.url)}
    />
  </head>
  <body>
    <nav class="concept-nav" aria-label="Redesign concepts">
      <a href="/">Current Site</a>
      <a href="#signal">01 Signal</a>
      <a href="#ledger">02 Ledger</a>
      <a href="#midnight">03 Midnight</a>
      <a href="#coast">04 Coast</a>
      <a href="#forge">05 Forge</a>
    </nav>

    <main>
      <section
        id="signal"
        class="concept signal"
        aria-labelledby="signal-title"
      >
        <div class="signal-grid">
          <aside class="signal-rail">
            <span>Hastings, UK</span>
            <span>Senior Back End Developer</span>
            <span>Available for focused engineering work</span>
          </aside>
          <div class="signal-hero">
            <p class="eyebrow">Concept 01 / Signal Room</p>
            <h1 id="signal-title">
              Kyle Scudder builds the quiet machinery behind useful products.
            </h1>
            <p>
              Back end developer with a bias for shipping reliable systems,
              readable APIs, and tools people actually keep using.
            </p>
            <div class="action-row">
              {
                contacts.map((contact) => (
                  <a href={contact.href}>{contact.label}</a>
                ))
              }
            </div>
          </div>
          <img
            class="signal-portrait"
            src="/me.png"
            alt="Memoji portrait of Kyle Scudder"
          />
          <div class="signal-panel panel-stack">
            <h2>Stack</h2>
            <div>
              {stack.map((item) => <span>{item}</span>)}
            </div>
          </div>
          <div class="signal-panel panel-now">
            <h2>Now</h2>
            <p>Learning Rust and ricing a Linux install.</p>
          </div>
          <div class="signal-panel panel-work">
            <h2>Recent</h2>
            {
              recentExperience.map((role) => (
                <article>
                  <strong>{role.position}</strong>
                  <span>{role.company}</span>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section
        id="ledger"
        class="concept ledger"
        aria-labelledby="ledger-title"
      >
        <div class="ledger-shell">
          <header>
            <p>Concept 02</p>
            <a href={LINKS.mail}>kyle@kylescudder.co.uk</a>
          </header>
          <div class="ledger-masthead">
            <h1 id="ledger-title">Kyle Scudder</h1>
            <img src="/me.png" alt="Memoji portrait of Kyle Scudder" />
          </div>
          <div class="ledger-columns">
            <article class="lede">
              <span>Profile</span>
              <p>
                Senior back end developer from Hastings, England. I design,
                build, and maintain durable server-side products with C#, .NET,
                TypeScript, and a pragmatic eye for delivery.
              </p>
            </article>
            <article>
              <span>Selected Work</span>
              {
                recentExperience.map((role) => (
                  <p>
                    <b>{role.position}</b> at {role.company}, {role.start} -{' '}
                    {role.end}
                  </p>
                ))
              }
            </article>
            <article>
              <span>Projects</span>
              <ul>
                {
                  featuredProjects.map((project) => (
                    <li>
                      <a href={project.HREF}>{project.TEXT}</a>
                    </li>
                  ))
                }
              </ul>
            </article>
          </div>
        </div>
      </section>

      <section
        id="midnight"
        class="concept midnight"
        aria-labelledby="midnight-title"
      >
        <div class="midnight-poster">
          <div class="poster-copy">
            <p class="eyebrow">Concept 03 / Midnight Feature</p>
            <h1 id="midnight-title">
              Systems with bite. Interfaces without noise.
            </h1>
            <p>
              A cinematic, high-contrast portfolio for a developer who likes
              fast APIs, horror shelves, live music, tattoos, and software that
              survives production.
            </p>
            <div class="poster-links">
              <a href={LINKS.github}>View GitHub</a>
              <a href="/CV.pdf">Download CV</a>
            </div>
          </div>
          <img src="/me.png" alt="Memoji portrait of Kyle Scudder" />
          <div class="poster-card">
            <span>Current Role</span>
            <strong>Senior Back End Developer</strong>
            <p>Crimson Tide / mpro5</p>
          </div>
        </div>
      </section>

      <section id="coast" class="concept coast" aria-labelledby="coast-title">
        <div class="coast-shell">
          <div class="coast-intro">
            <p class="eyebrow">Concept 04 / South Coast Studio</p>
            <h1 id="coast-title">
              Reliable back end craft with a coastal sense of space.
            </h1>
            <p>
              Calm, precise, and product-focused. A portfolio direction built
              around trust, technical depth, and room to read.
            </p>
            <div class="coast-actions">
              <a href={LINKS.linkedin}>LinkedIn</a>
              <a href={LINKS.mail}>Email</a>
            </div>
          </div>
          <img src="/me.png" alt="Memoji portrait of Kyle Scudder" />
          <div class="coast-board">
            <article>
              <span>Core</span>
              <strong>.NET / C# / APIs</strong>
            </article>
            <article>
              <span>Learning</span>
              <strong>Rust</strong>
            </article>
            <article>
              <span>Home</span>
              <strong>Hastings, England</strong>
            </article>
          </div>
        </div>
      </section>

      <section id="forge" class="concept forge" aria-labelledby="forge-title">
        <div class="forge-shell">
          <div class="forge-head">
            <p>Concept 05 / Forge Console</p>
            <h1 id="forge-title">
              Backend systems, shipped with pressure-tested judgement.
            </h1>
          </div>
          <div class="forge-layout">
            <img src="/me.png" alt="Memoji portrait of Kyle Scudder" />
            <div class="forge-terminal">
              <div>
                <span>$ whoami</span><p>
                  Kyle Scudder - Senior Back End Developer
                </p>
              </div>
              <div>
                <span>$ current</span><p>
                  Crimson Tide, mentoring engineers and delivering scoped
                  product bets.
                </p>
              </div>
              <div><span>$ stack</span><p>{stack.join(' / ')}</p></div>
              <div><span>$ contact</span><p>github.com/kylescudder</p></div>
            </div>
            <aside class="forge-projects">
              <h2>Repos</h2>
              {
                featuredProjects.map((project) => (
                  <a href={project.HREF}>{project.TEXT}</a>
                ))
              }
            </aside>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  @font-face {
    font-family: 'RedesignSerif';
    src: local('Iowan Old Style'), local('Georgia');
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #0d0d0b;
    color: #f6f1e8;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .concept-nav {
    position: fixed;
    z-index: 20;
    top: 14px;
    left: 50%;
    display: flex;
    max-width: calc(100vw - 24px);
    transform: translateX(-50%);
    gap: 6px;
    overflow-x: auto;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(9, 9, 8, 0.72);
    padding: 6px;
    backdrop-filter: blur(18px);
  }

  .concept-nav a {
    flex: 0 0 auto;
    padding: 8px 10px;
    color: #fff8e8;
    font-size: 11px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .concept {
    min-height: 100vh;
    overflow: hidden;
    padding: 78px clamp(18px, 4vw, 64px) 44px;
  }

  .eyebrow {
    margin: 0 0 18px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .signal {
    background:
      linear-gradient(90deg, rgba(238, 82, 45, 0.12) 1px, transparent 1px),
      linear-gradient(rgba(238, 82, 45, 0.08) 1px, transparent 1px),
      radial-gradient(
        circle at 72% 20%,
        rgba(238, 82, 45, 0.3),
        transparent 28%
      ),
      #10130f;
    background-size:
      42px 42px,
      42px 42px,
      auto,
      auto;
  }

  .signal-grid {
    display: grid;
    min-height: calc(100vh - 122px);
    grid-template-columns: 86px 1.25fr 0.75fr;
    grid-template-rows: 1fr auto auto;
    gap: 14px;
  }

  .signal-rail {
    display: flex;
    grid-row: 1 / 4;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid #f15a24;
    padding: 16px 10px;
    color: #f15a24;
    writing-mode: vertical-rl;
  }

  .signal-hero {
    align-self: end;
    padding-bottom: 32px;
  }

  .signal h1 {
    max-width: 980px;
    margin: 0;
    color: #fff4d7;
    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;
    font-size: clamp(54px, 9vw, 136px);
    font-weight: 900;
    line-height: 0.86;
    text-transform: uppercase;
  }

  .signal-hero p:not(.eyebrow) {
    max-width: 630px;
    color: #d6ceb9;
    font-size: clamp(17px, 2vw, 24px);
    line-height: 1.42;
  }

  .action-row,
  .poster-links,
  .coast-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .action-row a,
  .poster-links a,
  .coast-actions a {
    border: 1px solid currentColor;
    padding: 11px 14px;
    font-size: 12px;
    text-transform: uppercase;
    transition:
      transform 180ms ease,
      background 180ms ease,
      color 180ms ease;
  }

  .action-row a:hover,
  .poster-links a:hover,
  .coast-actions a:hover {
    transform: translateY(-2px);
  }

  .signal-portrait {
    align-self: end;
    justify-self: center;
    width: min(340px, 45vw);
    filter: drop-shadow(18px 18px 0 #f15a24);
  }

  .signal-panel {
    border: 1px solid rgba(255, 244, 215, 0.28);
    background: rgba(13, 16, 12, 0.74);
    padding: 18px;
  }

  .signal-panel h2 {
    margin: 0 0 14px;
    color: #f15a24;
    font-size: 13px;
    text-transform: uppercase;
  }

  .panel-stack div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .panel-stack span {
    background: #fff4d7;
    padding: 7px 9px;
    color: #11130f;
    font-size: 12px;
  }

  .panel-work {
    grid-column: 2 / 4;
  }

  .panel-work article {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid rgba(255, 244, 215, 0.18);
    padding: 10px 0;
  }

  .ledger {
    background: #f3ead7;
    color: #17130d;
  }

  .ledger-shell {
    min-height: calc(100vh - 122px);
    border-top: 4px double #17130d;
    border-bottom: 4px double #17130d;
    padding: 22px 0;
  }

  .ledger header,
  .ledger-masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid #17130d;
  }

  .ledger header {
    font-size: 12px;
    text-transform: uppercase;
  }

  .ledger-masthead h1 {
    margin: 18px 0;
    font-family: RedesignSerif, Georgia, serif;
    font-size: clamp(64px, 15vw, 190px);
    font-weight: 500;
    line-height: 0.82;
  }

  .ledger-masthead img {
    width: clamp(110px, 18vw, 210px);
    border: 1px solid #17130d;
    background: #d6c39a;
  }

  .ledger-columns {
    display: grid;
    grid-template-columns: 1.25fr 1fr 0.8fr;
    gap: 28px;
    padding-top: 28px;
  }

  .ledger article {
    border-left: 1px solid #17130d;
    padding-left: 18px;
  }

  .ledger span {
    display: block;
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .ledger p,
  .ledger li {
    font-family: Georgia, serif;
    font-size: clamp(18px, 2.5vw, 28px);
    line-height: 1.16;
  }

  .ledger .lede p {
    font-size: clamp(30px, 4vw, 58px);
    letter-spacing: 0;
  }

  .ledger ul {
    margin: 0;
    padding-left: 22px;
  }

  .midnight {
    background:
      linear-gradient(120deg, rgba(179, 9, 32, 0.78), transparent 42%),
      radial-gradient(
        circle at 77% 50%,
        rgba(255, 214, 76, 0.18),
        transparent 22%
      ),
      #080608;
    color: #fff0cf;
  }

  .midnight-poster {
    position: relative;
    display: grid;
    min-height: calc(100vh - 122px);
    grid-template-columns: 1fr minmax(220px, 410px);
    align-items: center;
    gap: 28px;
  }

  .midnight h1 {
    max-width: 900px;
    margin: 0;
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(58px, 10vw, 150px);
    line-height: 0.88;
    text-transform: uppercase;
    text-shadow: 6px 6px 0 #8e071f;
  }

  .poster-copy > p:not(.eyebrow) {
    max-width: 680px;
    color: #f3c98b;
    font-family: Georgia, serif;
    font-size: clamp(18px, 2.2vw, 26px);
    line-height: 1.35;
  }

  .midnight img {
    width: min(410px, 42vw);
    justify-self: center;
    transform: rotate(2deg);
    filter: saturate(0.82) contrast(1.2) drop-shadow(-18px 18px 0 #8e071f);
  }

  .poster-card {
    position: absolute;
    right: 4vw;
    bottom: 2vw;
    max-width: 260px;
    border: 1px solid #ffd64c;
    background: #12070b;
    padding: 18px;
  }

  .poster-card span {
    color: #ffd64c;
    font-size: 11px;
    text-transform: uppercase;
  }

  .poster-card strong {
    display: block;
    margin-top: 8px;
    font-size: 24px;
    line-height: 1;
  }

  .coast {
    background:
      radial-gradient(
        circle at 78% 18%,
        rgba(15, 92, 105, 0.22),
        transparent 26%
      ),
      linear-gradient(180deg, #edf6ef, #dbece8 52%, #f8f1df);
    color: #153139;
  }

  .coast-shell {
    display: grid;
    min-height: calc(100vh - 122px);
    grid-template-columns: 1fr minmax(220px, 360px);
    grid-template-rows: 1fr auto;
    align-items: center;
    gap: 28px;
  }

  .coast h1 {
    max-width: 980px;
    margin: 0;
    font-family: Optima, Candara, 'Trebuchet MS', sans-serif;
    font-size: clamp(50px, 8vw, 118px);
    font-weight: 500;
    line-height: 0.98;
  }

  .coast-intro > p:not(.eyebrow) {
    max-width: 620px;
    color: #42636a;
    font-family: Georgia, serif;
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.44;
  }

  .coast img {
    width: min(360px, 42vw);
    border-radius: 50%;
    background: #f5c45d;
    box-shadow: 0 0 0 18px rgba(21, 49, 57, 0.08);
  }

  .coast-board {
    display: grid;
    grid-column: 1 / 3;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .coast-board article {
    border-top: 1px solid rgba(21, 49, 57, 0.28);
    padding-top: 16px;
  }

  .coast-board span {
    color: #6b7f77;
    font-size: 12px;
    text-transform: uppercase;
  }

  .coast-board strong {
    display: block;
    margin-top: 8px;
    font-family: Georgia, serif;
    font-size: clamp(22px, 3vw, 42px);
    font-weight: 500;
  }

  .forge {
    background:
      linear-gradient(
        135deg,
        transparent 0 48%,
        rgba(255, 107, 53, 0.16) 48% 52%,
        transparent 52%
      ),
      #121212;
    color: #f7f2e8;
  }

  .forge-shell {
    min-height: calc(100vh - 122px);
  }

  .forge-head {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 24px;
    align-items: start;
    border-bottom: 1px solid rgba(247, 242, 232, 0.22);
    padding-bottom: 24px;
  }

  .forge-head p {
    margin: 0;
    color: #ff6b35;
    font-size: 12px;
    text-transform: uppercase;
  }

  .forge h1 {
    max-width: 1100px;
    margin: 0;
    font-family: 'Arial Narrow', Impact, sans-serif;
    font-size: clamp(52px, 8.5vw, 126px);
    line-height: 0.9;
    text-transform: uppercase;
  }

  .forge-layout {
    display: grid;
    grid-template-columns: minmax(180px, 280px) 1fr minmax(180px, 280px);
    gap: 18px;
    padding-top: 24px;
  }

  .forge img {
    width: 100%;
    align-self: start;
    background: #ff6b35;
    clip-path: polygon(8% 0, 100% 0, 92% 100%, 0 100%);
  }

  .forge-terminal {
    border: 1px solid rgba(247, 242, 232, 0.22);
    background: #050505;
    padding: 18px;
  }

  .forge-terminal div {
    border-bottom: 1px dashed rgba(247, 242, 232, 0.18);
    padding: 14px 0;
  }

  .forge-terminal span {
    color: #ff6b35;
    font-size: 12px;
  }

  .forge-terminal p {
    margin: 8px 0 0;
    font-size: clamp(18px, 2.4vw, 34px);
    line-height: 1.15;
  }

  .forge-projects {
    border: 1px solid #ff6b35;
    padding: 18px;
  }

  .forge-projects h2 {
    margin: 0 0 14px;
    color: #ff6b35;
    font-size: 14px;
    text-transform: uppercase;
  }

  .forge-projects a {
    display: block;
    border-top: 1px solid rgba(247, 242, 232, 0.2);
    padding: 13px 0;
  }

  @media (max-width: 820px) {
    .concept {
      padding-inline: 16px;
    }

    .signal-grid,
    .ledger-columns,
    .midnight-poster,
    .coast-shell,
    .forge-layout,
    .forge-head {
      display: block;
    }

    .signal-rail {
      margin-bottom: 18px;
      writing-mode: horizontal-tb;
    }

    .signal-portrait,
    .midnight img,
    .coast img {
      width: min(280px, 72vw);
      margin: 24px auto;
    }

    .signal-panel,
    .ledger article,
    .coast-board article,
    .forge-terminal,
    .forge-projects {
      margin-top: 12px;
    }

    .ledger-masthead {
      align-items: end;
    }

    .ledger-columns,
    .coast-board {
      grid-template-columns: 1fr;
    }

    .poster-card {
      position: static;
      margin-top: 18px;
    }

    .forge-projects {
      margin-top: 18px;
    }
  }
</style>
